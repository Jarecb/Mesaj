# Copy this file to .env and replace both credential placeholders before starting Compose.
# This example intentionally contains no usable credentials.
MONGO_ROOT_USERNAME=REPLACE_WITH_LOCAL_USERNAME
MONGO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
MONGODB_PORT=27017

# Kafka's external listener is bound to the local machine by Docker Compose.
KAFKA_EXTERNAL_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_MESSAGES_TOPIC=mesaj.messages
KAFKA_TOPIC_PARTITIONS=3

MAMA_PORT=9090
